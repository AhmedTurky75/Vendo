{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Duende.Bff": "Information",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "stores-api": {
        "ClusterId": "tenant-cluster",
        "Match": {
          "Path": "/api/stores/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/stores" },
          { "PathPrefix": "/api/stores" }
        ]
      },
      "catalog-api": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/catalog" },
          { "PathPrefix": "/api" }
        ]
      },
      "products-api": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/products" },
          { "PathPrefix": "/api/products" }
        ]
      },
      "order-api": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/orders" },
          { "PathPrefix": "/api" }
        ]
      },
      "payment-api": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/payments" },
          { "PathPrefix": "/api" }
        ]
      }
    },
    "Clusters": {
      "tenant-cluster": {
        "Destinations": {
          "tenant-destination": {
            "Address": "https://localhost:5005"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "catalog-destination": {
            "Address": "https://localhost:5002"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "order-destination": {
            "Address": "https://localhost:5003"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment-destination": {
            "Address": "https://localhost:5004"
          }
        }
      }
    }
  }
}
